# schema.graphqls

scalar DateTime
scalar BigDecimal
input VenueFilter {
    cityCode: String
    minPrice: BigDecimal
    maxPrice: BigDecimal
    startTimeBefore: DateTime
    startTimeAfter: DateTime
    categories: [String]
}

type Query {
    # 1. Query venue details by ID (primary-key lookup, highest performance).
    # This endpoint signature stays stable even if filter fields evolve.
    venueById(id: ID!): Venue

    # 2. Client-facing cursor-based pagination.
    venuesConnection(
        first: Int = 10, 
        after: String, 
        filter: VenueFilter
    ): VenueConnection

    # 3. Admin-facing offset pagination.
    #venuesPage(
    #    limit: Int = 10, 
    #    offset: Int = 0, 
    #    filter: VenueFilter
    #): VenuePageResponse
}
type VenueConnection {
    edges: [VenueEdge]
    pageInfo: PageInfo!
}

type VenueEdge {
    cursor: String!
    node: Venue
}

type PageInfo {
    hasNextPage: Boolean!
    endCursor: String
}
type Venue {
    id: ID!
    hostId: ID!
    name: String!
    address: String!
    cityCode: String
    latitude: Float!
    longitude: Float!
    description: String
    capacity: Int
    ticketTiers: [TicketTier!]!
    startTime: DateTime
    endTime: DateTime
    posterUrl: String
    status: VenueStatus
    createdAt: DateTime
    updatedAt: DateTime
}
type TicketTier {
    id: ID!
    tierName: String!
    price: Float!
    totalCapacity: Int!
    purchaseLimit: Int!
    saleStartTime: DateTime
    saleEndTime: DateTime
}

enum VenueStatus {
    UPCOMING
    SALE_ON
    SOLD_OUT
    FINISHED
    CANCELLED
}